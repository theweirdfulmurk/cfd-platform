# --- macOS / Windows / editor cruft ------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- secrets / local env -----------------------------------------------------
.env
.env.local
.env.*.local
*.key
*.pem

# --- Go ----------------------------------------------------------------------
# Compiled binaries from `go build` at the top of each module.
backend/server
backend/cmd/server/server
scheduler/scheduler
scheduler/cmd/*/*[!.]o

# Test / coverage artefacts.
*.test
*.out
coverage.txt
coverage.html

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# --- Frontend (Node) ---------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build / experiment outputs ---------------------------------------------
# Local experiment artefacts must not be committed — they are large and noisy.
experiment/results/
experiment/*.mpiP
*.log

# Docker layers cache (BuildKit creates this if you use --output type=local).
.buildx-cache/
